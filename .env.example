# Puerto HTTP/WebSocket. El frontend (Vite) hace proxy a este puerto en desarrollo.
PORT=3000

# Orígenes permitidos para CORS, separados por comas.
# Vacío = se permite el origen del propio Web Service (producción en Render, mismo dominio).
# En desarrollo local el dev server de Vite suele correr en http://localhost:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nivel de log de Nest: log,error,warn,debug,verbose (separados por comas).
LOG_LEVELS=log,error,warn

# Audit endpoints (/api/test/telemetry, /api/test/seed).
# Enabled when ENABLE_TEST_ENDPOINTS=true, or NODE_ENV != production.
# Set ENABLE_TEST_ENDPOINTS=false to disable them everywhere.
ENABLE_TEST_ENDPOINTS=true
