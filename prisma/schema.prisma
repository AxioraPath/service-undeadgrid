// Prisma schema de Undead Grid.
// Datos de cuenta, perfil, estadísticas, historial de partidas y tokens.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cuenta de usuario (login).
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  displayName   String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  profile       PlayerProfile?
  stats         PlayerStats?
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]

  @@map("users")
}

/// Datos de juego del jugador (1:1 con User).
model PlayerProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level             Int      @default(1)
  xp                Int      @default(0)
  preferredSurvivor String   @default("explorador")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("player_profiles")
}

/// Estadísticas agregadas del jugador (1:1 con User).
model PlayerStats {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchesPlayed   Int      @default(0)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)
  coresDestroyed  Int      @default(0)
  zombiesKilled   Int      @default(0)
  structuresBuilt Int      @default(0)
  totalPlaytimeS  Int      @default(0)
  bestStreak      Int      @default(0)
  currentStreak   Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("player_stats")
}

/// Historial de partidas jugadas.
model MatchHistory {
  id         String   @id @default(uuid())
  code       String
  mapId      String
  difficulty String
  seed       BigInt
  durationS  Int
  reason     String // core_destroyed | time_out | opponent_left
  createdAt  DateTime @default(now())

  players MatchPlayer[]

  @@index([createdAt])
  @@index([reason])
  @@index([code])
  @@map("match_history")
}

/// Participación de un jugador en una partida (2 por partida en 1v1).
model MatchPlayer {
  id        String       @id @default(uuid())
  matchId   String
  match     MatchHistory @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String?      // null si el jugador era invitado sin cuenta
  slot      Int          // 1 (azul) o 2 (rojo)
  name      String
  survivor  String
  isWinner  Boolean      @default(false)
  coreHpEnd Int          @default(0)

  @@index([userId])
  @@map("match_players")
}

/// Refresh tokens para renovar sesiones (se guarda solo el hash).
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Tokens de recuperación de contraseña (se guarda solo el hash).
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
